{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "4.0",
  "description": "PhishLens Client-side Anti-phishing Extension with Dynamic Behavioural Threat Detection",
  "permissions": [
    "webRequest",
    "webNavigation",
    "declarativeNetRequest",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/lib/jsqr.min.js",
        "src/content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "public/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' https://api.openai.com http://localhost:5000 http://localhost:5024; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "icons/warning.png",
        "public/phishing.html",
        "public/dist.css",
        "src/lib/jsqr.min.js"
      ]
    }
  ],
  "icons": {
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}